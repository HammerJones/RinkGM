static var _bits := {}


## Rows of the glyph as 5-bit masks (bit 4 = leftmost pixel).
static func rows(ch: String) -> PackedInt32Array:
	if _bits.is_empty():
		for k in GLYPHS:
			var out := PackedInt32Array()
			for r in GLYPHS[k].split(" "):
				var m := 0
				for i in W:
					if r[i] == "#":
						m |= 1 << (W - 1 - i)
				out.append(m)
			_bits[k] = out
	var key := ch.to_upper()
	return _bits[key] if _bits.has(key) else _bits["?"]


static func text_width(text: String) -> int:
	return maxi(text.length() * ADVANCE - 1, 0)


## Draws `text` with its top-left pixel at (x, y), `scale` image pixels per
## font pixel.
static func draw(img: Image, text: String, x: int, y: int, col: Color, scale := 1) -> void:
	for ci in text.length():
		var r := rows(text[ci])
		for row in H:
			var m: int = r[row]
			if m == 0:
				continue
			for i in W:
				if m & (1 << (W - 1 - i)):
					img.fill_rect(Rect2i(x + (ci * ADVANCE + i) * scale, y + row * scale, scale, scale), col)
