	"H": "#...# #...# #...# ##### #...# #...# #...#",
	"I": ".###. ..#.. ..#.. ..#.. ..#.. ..#.. .###.",
	"J": "..### ...#. ...#. ...#. ...#. #..#. .##..",
	"K": "#...# #..#. #.#.. ##... #.#.. #..#. #...#",
