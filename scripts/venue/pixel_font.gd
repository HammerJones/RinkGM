class_name PixelFont
extends RefCounted
## A 5x7 bitmap font for in-world signs (scoreboards, door plates, banners).
## Signs are drawn pixel by pixel into an Image and shown with nearest
## filtering, so they stay crisp at any distance, matching the pixel-terminal
## "Mission Control" UI. Lower case is drawn as upper case.

const W := 5
const H := 7
const ADVANCE := 6  # glyph width plus one pixel of spacing
const LINE := 9     # glyph height plus two pixels of leading

const GLYPHS := {
	"A": ".###. #...# #...# ##### #...# #...# #...#",
	"B": "####. #...# #...# ####. #...# #...# ####.",
