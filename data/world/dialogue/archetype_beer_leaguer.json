{
  "id": "archetype_beer_leaguer",
  "start": [
    {
      "if": [
        {
          "mood_lt": 0.4
        }
      ],
      "node": "grumpy"
    },
    {
      "if": [
        {
          "rel_lt": [
            "self",
            -15
          ]
        }
      ],
      "node": "grumpy"
    },
    {
      "if": [
        {
          "event_now": "beer_league"
        }
      ],
      "node": "event"
    },
    {
      "if": [
        {
          "hour_between": [
            22,
            24
          ]
        }
      ],
      "node": "time"
    },
    {
      "if": [
        {
          "rel_gte": [
            "self",
            30
          ]
        }
      ],
      "node": "friend"
    },
    {
      "node": "hub"
    }
  ],
  "nodes": {
    "grumpy": {
      "say": [
        "We paid for ice time, {owner}. We got ice-ish time.",
        "My knee hurts, my team lost and the scoreboard's still dead. Great night.",
        "@how_are_things"
      ],
      "options": [
        {
          "text": "I'm sorry. What would make it better?",
          "do": [
            {
              "rel": [
                "self",
                1
              ]
            },
            {
              "mood": 0.03
            }
          ],
          "to": "better"
        },
        {
          "text": "It's an old building. Bear with us.",
          "to": "hub"
        },
        {
          "text": "Rinks are hard. Take it or leave it.",
          "do": [
            {
              "rel": [
                "self",
                -3
              ]
            },
            {
              "mood": -0.03
            }
          ],
          "to": "end"
        }
      ]
    },
    "event": {
      "say": [
        "Game night. We're down three skaters and up one cooler.",
        "We're playing the Pallbearers. They're so polite. It's terrifying.",
        "{event}. Big game. They're all big games. None of them matter. It's perfect."
      ],
      "options": [
        {
          "text": "Win one for me.",
          "do": [
            {
              "rel": [
                "self",
                1
              ]
            }
          ],
          "to": "love"
        },
        {
          "text": "Try not to pull anything.",
          "to": "hub"
        }
      ]
    },
    "time": {
      "say": [
        "Eleven fifteen puck drop. My alarm goes at six. I've made peace with it.",
        "Late ice is the best ice. Nobody's watching. Nobody should be."
      ],
      "options": [
        {
          "text": "Good to see you anyway.",
          "to": "hub"
        }
      ]
    },
    "friend": {
      "say": [
        "{owner}! Our sub skated with us last week. You should come out. We need a body. Any body.",
        "There's my favourite owner. You still owe me a game. I don't know why. You just do."
      ],
      "options": [
        {
          "text": "Good to see you too, {known_as}.",
          "to": "hub"
        }
      ]
    },
    "hub": {
      "say": [
        "@how_are_things",
        "What's up, {owner}? Make it quick, I have to tape a stick I already taped.",
        "Hey. If this is about the dues, talk to Dale. Everything goes through the binder."
      ],
      "hub": true,
      "options": [
        {
          "text": "How's the season going?",
          "to": "love"
        },
        {
          "text": "What brings you to the rink?",
          "to": "why"
        },
        {
          "text": "What do you make of the rink?",
          "to": "rink"
        },
        {
          "text": "What's new in the league?",
          "to": "gossip"
        },
        {
          "text": "What would make this place better for you?",
          "to": "better"
        },
        {
          "text": "Take care.",
          "to": "bye"
        }
      ]
    },
    "love": {
      "say": [
        "We're 3 and 9. But two of those were close. One was very close. We lost.",
        "Best part of my week. Ninety minutes where nobody calls me at work.",
        "We've got a guy who played Junior B for half a season. We hear about it every shift."
      ],
      "options": [
        {
          "text": "That's what it's all about.",
          "do": [
            {
              "rel": [
                "self",
                1
              ]
            }
          ],
          "to": "hub"
        }
      ]
    },
    "why": {
      "say": "@why_here",
      "options": [
        {
          "text": "Tell me a bit about yourself.",
          "to": "about"
        },
        {
          "text": "Glad you come.",
          "do": [
            {
              "rel": [
                "self",
                1
              ]
            }
          ],
          "to": "hub"
        }
      ]
    },
    "about": {
      "say": "@about",
      "options": [
        {
          "text": "Good to know you, {known_as}.",
          "to": "hub"
        }
      ]
    },
    "rink": {
      "say": [
        "The HOME scoreboard's been dead since forever. Doreen hangs painted numbers. It's charming. It's also dead.",
        "The showers run hot for about four guys. After that it's character building.",
        "@ice"
      ],
      "options": [
        {
          "text": "The ice has been better lately, hasn't it?",
          "if": [
            {
              "ice_gte": 62
            }
          ],
          "to": "ice_up"
        },
        {
          "text": "Noticed the work on the building?",
          "if": [
            {
              "rooms_gte": 45
            }
          ],
          "to": "rooms_up"
        },
        {
          "text": "Fair enough. We're working on it.",
          "to": "hub"
        }
      ]
    },
    "ice_up": {
      "say": [
        "The ice is quick now. Too quick. I can't blame the ice any more.",
        "Fewer ruts. I fell over on my own last week. Very humbling."
      ],
      "options": [
        {
          "text": "Glad it shows.",
          "do": [
            {
              "rel": [
                "self",
                1
              ]
            }
          ],
          "to": "hub"
        }
      ]
    },
    "rooms_up": {
      "say": [
        "Hot water for the whole team! I stood in the shower and thought about my life.",
        "The rooms got done up. We feel like a real team. We are not a real team."
      ],
      "options": [
        {
          "text": "That's the idea.",
          "do": [
            {
              "rel": [
                "self",
                1
              ]
            }
          ],
          "to": "hub"
        }
      ]
    },
    "gossip": {
      "say": [
        "Dale Huffman's chasing dues again. Owner or not, he says, everybody pays. He means you.",
        "Dwayne's got the Ice Holes' pitcher pre-ordered for 10:45. The hockey's in the way."
      ],
      "options": [
        {
          "text": "Ha. Good to know.",
          "to": "hub"
        }
      ]
    },
    "better": {
      "say": [
        "Fix the HOME scoreboard. I want to see us lose in lights.",
        "Get the scoreboard working. Both sides. I want proof we scored once."
      ],
      "options": [
        {
          "text": "I'll see what I can do.",
          "if": [
            {
              "not_flag": "heard_wants_working_scoreboard"
            }
          ],
          "do": [
            {
              "set": "heard_wants_working_scoreboard"
            },
            {
              "rel": [
                "self",
                2
              ]
            }
          ],
          "to": "hub"
        },
        {
          "text": "Can't promise anything, but noted.",
          "if": [
            {
              "not_flag": "heard_wants_working_scoreboard"
            }
          ],
          "do": [
            {
              "set": "heard_wants_working_scoreboard"
            }
          ],
          "to": "hub"
        },
        {
          "text": "You're not the first to say it. It's on the list.",
          "if": [
            {
              "flag": "heard_wants_working_scoreboard"
            }
          ],
          "do": [
            {
              "rel": [
                "self",
                1
              ]
            }
          ],
          "to": "hub"
        }
      ]
    },
    "bye": {
      "say": [
        "Off to the room. Somebody's got to find the tape.",
        "See you next week. Same time. Same knee."
      ]
    }
  }
}
