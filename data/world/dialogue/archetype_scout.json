{
  "id": "archetype_scout",
  "start": [
    {
      "if": [
        {
          "mood_lt": 0.4
        }
      ],
      "node": "grumpy"
    },
    {
      "if": [
        {
          "rel_lt": [
            "self",
            -15
          ]
        }
      ],
      "node": "grumpy"
    },
    {
      "if": [
        {
          "event_now": "senior_hockey"
        }
      ],
      "node": "event"
    },
    {
      "if": [
        {
          "event_now": "tournament"
        }
      ],
      "node": "event"
    },
    {
      "if": [
        {
          "event_now": "high_school"
        }
      ],
      "node": "event"
    },
    {
      "if": [
        {
          "hour_between": [
            21,
            24
          ]
        }
      ],
      "node": "time"
    },
    {
      "if": [
        {
          "rel_gte": [
            "self",
            30
          ]
        }
      ],
      "node": "friend"
    },
    {
      "node": "hub"
    }
  ],
  "nodes": {
    "grumpy": {
      "say": [
        "Drove four hours. Couldn't see a thing. Not happy.",
        "Rough sheet, rough night. Noted.",
        "@how_are_things"
      ],
      "options": [
        {
          "text": "I'm sorry. What would make it better?",
          "do": [
            {
              "rel": [
                "self",
                1
              ]
            },
            {
              "mood": 0.03
            }
          ],
          "to": "better"
        },
        {
          "text": "It's an old building. Bear with us.",
          "to": "hub"
        },
        {
          "text": "Rinks are hard. Take it or leave it.",
          "do": [
            {
              "rel": [
                "self",
                -3
              ]
            },
            {
              "mood": -0.03
            }
          ],
          "to": "end"
        }
      ]
    },
    "event": {
      "say": [
        "Watching number 22. Feet. Watch the feet.",
        "{event}. I'm not here. You didn't see me.",
        "Good game to watch. Bad game to play. That's why I watch."
      ],
      "options": [
        {
          "text": "Anybody worth watching?",
          "do": [
            {
              "rel": [
                "self",
                1
              ]
            }
          ],
          "to": "love"
        },
        {
          "text": "I'll leave you to it.",
          "to": "hub"
        }
      ]
    },
    "time": {
      "say": [
        "Long drive home. Worth it, maybe.",
        "Late game. I've seen worse. I've driven farther."
      ],
      "options": [
        {
          "text": "Good to see you anyway.",
          "to": "hub"
        }
      ]
    },
    "friend": {
      "say": [
        "{owner}. Good rink. Small. I'll be back.",
        "Owner. Coffee? I'll buy. Don't tell anybody."
      ],
      "options": [
        {
          "text": "Good to see you too, {known_as}.",
          "to": "hub"
        }
      ]
    },
    "hub": {
      "say": [
        "@how_are_things",
        "Hm. Yes?",
        "Go ahead. I'm listening. I'm watching too."
      ],
      "hub": true,
      "options": [
        {
          "text": "What are you looking for?",
          "to": "love"
        },
        {
          "text": "What brings you to the rink?",
          "to": "why"
        },
        {
          "text": "What do you make of the rink?",
          "to": "rink"
        },
        {
          "text": "Heard of anyone good around here?",
          "to": "gossip"
        },
        {
          "text": "What would make this place better for you?",
          "to": "better"
        },
        {
          "text": "Take care.",
          "to": "bye"
        }
      ]
    },
    "love": {
      "say": [
        "Hockey sense. You can't teach it. You can ruin it, though.",
        "The kid who skates hardest in the third period of a blowout. That one.",
        "Feet, hands, head. Mostly head. Mostly feet."
      ],
      "options": [
        {
          "text": "Good luck finding them.",
          "do": [
            {
              "rel": [
                "self",
                1
              ]
            }
          ],
          "to": "hub"
        }
      ]
    },
    "why": {
      "say": "@why_here",
      "options": [
        {
          "text": "Tell me a bit about yourself.",
          "to": "about"
        },
        {
          "text": "Glad you come.",
          "do": [
            {
              "rel": [
                "self",
                1
              ]
            }
          ],
          "to": "hub"
        }
      ]
    },
    "about": {
      "say": "@about",
      "options": [
        {
          "text": "Good to know you, {known_as}.",
          "to": "hub"
        }
      ]
    },
    "rink": {
      "say": [
        "Glass is scratched. Hard to see the hands through it.",
        "Small rink. Big rinks hide things. Small rinks don't.",
        "@ice"
      ],
      "options": [
        {
          "text": "The ice has been better lately, hasn't it?",
          "if": [
            {
              "ice_gte": 62
            }
          ],
          "to": "ice_up"
        },
        {
          "text": "Noticed the work on the building?",
          "if": [
            {
              "rooms_gte": 45
            }
          ],
          "to": "rooms_up"
        },
        {
          "text": "Fair enough. We're working on it.",
          "to": "hub"
        }
      ]
    },
    "ice_up": {
      "say": [
        "Fast sheet now. Separates the skaters from the hopers.",
        "Good ice. I can see who can skate. Some can't."
      ],
      "options": [
        {
          "text": "Glad it shows.",
          "do": [
            {
              "rel": [
                "self",
                1
              ]
            }
          ],
          "to": "hub"
        }
      ]
    },
    "rooms_up": {
      "say": [
        "Better stands. Somewhere to sit and not freeze. I'll stay a period longer.",
        "Coffee's warmer. Seats are warmer. Noted."
      ],
      "options": [
        {
          "text": "That's the idea.",
          "do": [
            {
              "rel": [
                "self",
                1
              ]
            }
          ],
          "to": "hub"
        }
      ]
    },
    "gossip": {
      "say": [
        "There's a kid in the U13s, Little Sauce. Hm. Too much pressure. Watch him smile. Or not.",
        "Old Pete Vachon's got the best notebook in the valley. Don't tell him I said."
      ],
      "options": [
        {
          "text": "Ha. Good to know.",
          "to": "hub"
        }
      ]
    },
    "better": {
      "say": [
        "New glass. I can't see through this. I'm not here to watch scratches.",
        "Clear glass. That's all. Clear glass."
      ],
      "options": [
        {
          "text": "I'll see what I can do.",
          "if": [
            {
              "not_flag": "heard_wants_clear_glass"
            }
          ],
          "do": [
            {
              "set": "heard_wants_clear_glass"
            },
            {
              "rel": [
                "self",
                2
              ]
            }
          ],
          "to": "hub"
        },
        {
          "text": "Can't promise anything, but noted.",
          "if": [
            {
              "not_flag": "heard_wants_clear_glass"
            }
          ],
          "do": [
            {
              "set": "heard_wants_clear_glass"
            }
          ],
          "to": "hub"
        },
        {
          "text": "You're not the first to say it. It's on the list.",
          "if": [
            {
              "flag": "heard_wants_clear_glass"
            }
          ],
          "do": [
            {
              "rel": [
                "self",
                1
              ]
            }
          ],
          "to": "hub"
        }
      ]
    },
    "bye": {
      "say": [
        "Hm. Bye.",
        "I'll see you. Or I won't. I'll be here though."
      ]
    }
  }
}
