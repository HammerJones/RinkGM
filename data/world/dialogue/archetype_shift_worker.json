{
  "id": "archetype_shift_worker",
  "start": [
    {
      "if": [
        {
          "mood_lt": 0.4
        }
      ],
      "node": "grumpy"
    },
    {
      "if": [
        {
          "rel_lt": [
            "self",
            -15
          ]
        }
      ],
      "node": "grumpy"
    },
    {
      "if": [
        {
          "event_now": "stick_and_puck"
        }
      ],
      "node": "event"
    },
    {
      "if": [
        {
          "hour_between": [
            5,
            9
          ]
        }
      ],
      "node": "time"
    },
    {
      "if": [
        {
          "rel_gte": [
            "self",
            30
          ]
        }
      ],
      "node": "friend"
    },
    {
      "node": "hub"
    }
  ],
  "nodes": {
    "grumpy": {
      "say": [
        "Got booked over again. Only hour I had off this rotation.",
        "Rough shift, rough ice. Not a good combination.",
        "@how_are_things"
      ],
      "options": [
        {
          "text": "I'm sorry. What would make it better?",
          "do": [
            {
              "rel": [
                "self",
                1
              ]
            },
            {
              "mood": 0.03
            }
          ],
          "to": "better"
        },
        {
          "text": "It's an old building. Bear with us.",
          "to": "hub"
        },
        {
          "text": "Rinks are hard. Take it or leave it.",
          "do": [
            {
              "rel": [
                "self",
                -3
              ]
            },
            {
              "mood": -0.03
            }
          ],
          "to": "end"
        }
      ]
    },
    "event": {
      "say": [
        "Just off nights. This is my evening. It's 10 am.",
        "{event}. Nobody here at this hour. That's why I'm here.",
        "Fourteen hours of machine noise, now the sweet sound of nothing."
      ],
      "options": [
        {
          "text": "Good skate?",
          "do": [
            {
              "rel": [
                "self",
                1
              ]
            }
          ],
          "to": "love"
        },
        {
          "text": "Enjoy the quiet.",
          "to": "hub"
        }
      ]
    },
    "time": {
      "say": [
        "You're up early. Or late. Same as me.",
        "Morning. Night. Hi."
      ],
      "options": [
        {
          "text": "Good to see you anyway.",
          "to": "hub"
        }
      ]
    },
    "friend": {
      "say": [
        "{owner}. Keep the weekday ice. Some of us work nights. Thanks for that.",
        "Hey. Good to see a face that's not at the mill."
      ],
      "options": [
        {
          "text": "Good to see you too, {known_as}.",
          "to": "hub"
        }
      ]
    },
    "hub": {
      "say": [
        "@how_are_things",
        "Yeah? What's up?",
        "Hm? Sorry, still running on shift time."
      ],
      "hub": true,
      "options": [
        {
          "text": "What's it like coming here after a night shift?",
          "to": "love"
        },
        {
          "text": "What brings you to the rink?",
          "to": "why"
        },
        {
          "text": "What do you make of the rink?",
          "to": "rink"
        },
        {
          "text": "Know anyone else on shifts who comes out?",
          "to": "gossip"
        },
        {
          "text": "What would make this place better for you?",
          "to": "better"
        },
        {
          "text": "Take care.",
          "to": "bye"
        }
      ]
    },
    "love": {
      "say": [
        "Quiet. Cold. Just me and a bucket of pucks. Better than sleep.",
        "Takes the mill out of my ears. Then I go home and sleep till four.",
        "Nobody here to ask me for anything. That's the whole point."
      ],
      "options": [
        {
          "text": "Sounds like you've earned it.",
          "do": [
            {
              "rel": [
                "self",
                1
              ]
            }
          ],
          "to": "hub"
        }
      ]
    },
    "why": {
      "say": "@why_here",
      "options": [
        {
          "text": "Tell me a bit about yourself.",
          "to": "about"
        },
        {
          "text": "Glad you come.",
          "do": [
            {
              "rel": [
                "self",
                1
              ]
            }
          ],
          "to": "hub"
        }
      ]
    },
    "about": {
      "say": "@about",
      "options": [
        {
          "text": "Good to know you, {known_as}.",
          "to": "hub"
        }
      ]
    },
    "rink": {
      "say": [
        "Ice is fine. It's a rink. I'm not fussy.",
        "Better than the floor at the mill. Barely.",
        "@ice"
      ],
      "options": [
        {
          "text": "The ice has been better lately, hasn't it?",
          "if": [
            {
              "ice_gte": 62
            }
          ],
          "to": "ice_up"
        },
        {
          "text": "Noticed the work on the building?",
          "if": [
            {
              "rooms_gte": 45
            }
          ],
          "to": "rooms_up"
        },
        {
          "text": "Fair enough. We're working on it.",
          "to": "hub"
        }
      ]
    },
    "ice_up": {
      "say": [
        "Good ice. Good morning. Night. Whatever it is.",
        "Fresh sheet and nobody on it. That'll do nicely."
      ],
      "options": [
        {
          "text": "Glad it shows.",
          "do": [
            {
              "rel": [
                "self",
                1
              ]
            }
          ],
          "to": "hub"
        }
      ]
    },
    "rooms_up": {
      "say": [
        "Hot showers. That's all I ever wanted from a rink.",
        "Lobby's nice. I'd nap in it. I won't. Probably."
      ],
      "options": [
        {
          "text": "That's the idea.",
          "do": [
            {
              "rel": [
                "self",
                1
              ]
            }
          ],
          "to": "hub"
        }
      ]
    },
    "gossip": {
      "say": [
        "Hank Lavoie runs a paper machine on nights. Shoots a hundred pucks after. Never says a word.",
        "Hank comes to broomball Wednesdays and laughs once. Loud. At something nobody else saw."
      ],
      "options": [
        {
          "text": "Ha. Good to know.",
          "to": "hub"
        }
      ]
    },
    "better": {
      "say": [
        "Ice in the mornings after nights. Six am to eight. Every weekday.",
        "Keep the early ice open. That's all. Some of us work nights."
      ],
      "options": [
        {
          "text": "I'll see what I can do.",
          "if": [
            {
              "not_flag": "heard_wants_morning_ice"
            }
          ],
          "do": [
            {
              "set": "heard_wants_morning_ice"
            },
            {
              "rel": [
                "self",
                2
              ]
            }
          ],
          "to": "hub"
        },
        {
          "text": "Can't promise anything, but noted.",
          "if": [
            {
              "not_flag": "heard_wants_morning_ice"
            }
          ],
          "do": [
            {
              "set": "heard_wants_morning_ice"
            }
          ],
          "to": "hub"
        },
        {
          "text": "You're not the first to say it. It's on the list.",
          "if": [
            {
              "flag": "heard_wants_morning_ice"
            }
          ],
          "do": [
            {
              "rel": [
                "self",
                1
              ]
            }
          ],
          "to": "hub"
        }
      ]
    },
    "bye": {
      "say": [
        "Right. Bed.",
        "See you after the next rotation."
      ]
    }
  }
}
