{
  "id": "earl_bratt",
  "barks": {
    "idle": [
      "She runs better when nobody talks to her.",
      "Water's at 55. Should be 60.",
      "Nine thousand four hundred and something. I don't count out loud."
    ],
    "good_ice": [
      "That'll do.",
      "You didn't kill her. Fine.",
      "Hm. Glass."
    ],
    "bad_ice": [
      "Who flooded this. Don't tell me.",
      "That's not ice. That's a rumour of ice.",
      "Bag of marbles. Cold water did that."
    ],
    "wet_ice": [
      "Give it ten minutes. Ice doesn't hurry.",
      "Wet. Somebody didn't wait."
    ],
    "goal": [
      "Off the dead board. Course it was.",
      "Hm."
    ],
    "cold": [
      "Cold's good. Cold's the job."
    ],
    "bored": [
      "Could be flooding.",
      "Nobody watches the flood. They go for fries."
    ],
    "greet_owner": [
      "You.",
      "Morning. She's warm.",
      "You again. Fine."
    ],
    "leaving_happy": [
      "Ice held. Night."
    ],
    "leaving_angry": [
      "Call me when you've learned what a squeegee's for."
    ],
    "event_specific": {
      "beer_league": [
        "Flood Crew's on. Get your gear.",
        "Second intermission flood. Eight minutes. Watch me."
      ],
      "stick_and_puck": [
        "Keep the pucks off my bay door."
      ],
      "senior_hockey": [
        "Kings get a fast sheet. They'll get one."
      ],
      "special": [
        "Doris is in a ribbon. Once. Don't make it a habit."
      ]
    }
  },
