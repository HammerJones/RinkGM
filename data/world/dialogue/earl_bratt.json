    "beer_player": {
      "say": "You're my partner. Don't chase. Rim it to the dead board behind the north net and I'll be where it comes out.",
      "options": [
        {
          "text": "Got it.",
          "do": [
            {
              "rel": [
                "earl_bratt",
                1
              ]
            }
          ],
          "to": "hub"
        }
      ]
    },
    "friendly": {
      "say": [
        "Water's at 60. Somebody fixed the heater. Fine.",
        "You're early. She likes early.",
        "Tally's at nine thousand four hundred and something. You're in a few of them."
