  "nodes": {
    "first": {
      "say": "You're the one who bought her for a dollar. The building, I mean. Doris isn't for sale.",
      "do": [
        {
          "set": "met_earl_bratt"
        }
      ],
      "options": [
        {
          "text": "I'd love your help with the ice, Earl.",
          "do": [
            {
              "rel": [
                "earl_bratt",
                3
              ]
            }
          ],
          "to": "first_help"
        },
        {
          "text": "Who's Doris?",
          "do": [
            {
              "rel": [
                "earl_bratt",
                -5
              ]
            }
          ],
          "to": "first_doris"
        },
        {
          "text": "The town says you quit.",
          "do": [
            {
              "rel": [
                "earl_bratt",
                -2
              ]
            }
          ],
          "to": "first_quit"
        }
      ]
    },
    "first_help": {
      "say": "I'm retired. I'm only here to check she's warm. Keep the ice over 45 for two weeks and we'll talk.",
      "options": [
        {
          "text": "Fair enough.",
          "to": "hub"
        }
      ]
    },
    "first_doris": {
      "say": "The 1974 Zambelli Model 525 in the bay. She was running before you were a rumour. Don't touch her choke.",
      "options": [
        {
          "text": "Noted.",
          "to": "hub"
        }
      ]
    },
    "first_quit": {
      "say": "Took my pension. Different thing. Quitting is when you stop caring.",
      "options": [
        {
          "text": "Then you still care.",
          "do": [
            {
              "rel": [
                "earl_bratt",
                2
              ]
            }
          ],
          "to": "hub"
        },
        {
          "text": "Okay.",
          "to": "hub"
        }
      ]
    },
    "grumpy": {
      "say": [
        "@how_are_things",
        "Ice is {ice_word}. You know what I'm going to say."
      ],
      "options": [
        {
          "text": "What went wrong?",
          "to": "grumpy_fix"
        },
        {
          "text": "I know. I'm on it.",
          "do": [
            {
              "rel": [
                "earl_bratt",
                1
              ]
            }
          ],
          "to": "hub"
        }
      ]
    },
    "grumpy_fix": {
      "say": "Floods too cold. Ice too fat. Boards never edged. Pick one, you'll be right. Then let her sit between floods.",
      "options": [
        {
          "text": "Thanks, Earl.",
          "to": "hub"
        }
      ]
    },
    "dawn": {
      "say": "Five in the morning. Figure ice at six. Hélène checks it with her blade like a doctor with cold hands.",
      "options": [
        {
          "text": "Can I watch the flood?",
          "if": [
            {
              "not_flag": "earl_watched_flood"
            }
          ],
          "to": "dawn_watch"
        },
        {
          "text": "I'll leave you to it.",
          "to": "end"
        }
      ]
    },
    "dawn_watch": {
      "say": "Stand by the door. Don't talk. Watch the overlap. Six inches, every pass.",
      "do": [
        {
          "set": "earl_watched_flood"
        },
        {
          "rel": [
            "earl_bratt",
            3
          ]
        },
        {
          "note": "Earl let you watch the 05:00 flood. Six inches of overlap, every pass."
        }
      ],
      "options": [
        {
          "text": "(Watch in silence.)",
          "to": "hub"
        }
      ]
    },
    "beer": {
      "say": "Flood Crew plays tonight. Defence wins games. Floods win seasons.",
      "options": [
        {
          "text": "Want me out there with you?",
