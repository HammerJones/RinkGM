  "nodes": {
    "first": {
      "say": "BIG GORD HALVORSEN! BIG GORD'S TRUCKS, KESSLER, SINCE 1977! BIG GORD WON'T LET YOU WALK! ...Nice to meet you, kid. Welcome to the valley.",
      "do": [
        {
          "set": "met_gordon_halvorsen"
        }
      ],
      "options": [
        {
          "text": "Nice to meet you, Big Gord!",
          "do": [
            {
              "rel": [
                "gordon_halvorsen",
                3
              ]
            }
          ],
          "to": "hub"
        },
        {
          "text": "Do you ever not shout?",
          "do": [
            {
              "rel": [
                "gordon_halvorsen",
                1
              ]
            }
          ],
          "to": "first_quiet"
        }
      ]
    },
    "first_quiet": {
      "say": "...Once. In 1985. At my daughter's recital. The quiet part. Then I shouted at the end. She still talks about it. BIG GORD LOVES RECITALS!",
      "options": [
        {
          "text": "That's lovely, Gord.",
          "do": [
            {
              "rel": [
                "gordon_halvorsen",
                2
              ]
            }
          ],
          "to": "hub"
        }
      ]
    },
    "grumpy": {
      "say": "@how_are_things",
