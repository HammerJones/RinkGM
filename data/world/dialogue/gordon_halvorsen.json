      "hub": true,
      "options": [
        {
          "text": "How's the truck lot?",
          "to": "job"
        },
        {
          "text": "Put the rink on one of your billboards?",
          "if": [
            {
              "not_flag": "gord_billboard_decided"
            }
          ],
          "to": "billboard"
        },
        {
          "text": "What's with you and June Penner?",
          "to": "june"
        },
        {
          "text": "What do you think of the rink?",
          "to": "rink"
        },
        {
          "text": "Would the lot hire from our jobs board?",
          "if": [
            {
              "path": "gm"
            }
          ],
          "to": "gm"
        },
        {
          "text": "See you, Gord.",
          "to": "end"
        }
      ]
    },
    "job": {
      "say": "SAME LOT SINCE 1977! I sold Earl his first truck! He still drives it! He says it's the only thing I ever sold that worked! HA! THAT'S A COMPLIMENT FROM EARL!",
      "options": [
        {
          "text": "That really is, from Earl.",
          "do": [
            {
              "rel": [
                "earl_bratt",
                1
              ]
            }
          ],
          "to": "hub"
        }
      ]
    },
