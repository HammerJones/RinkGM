      "options": [
        {
          "text": "Hand a few out, Gord.",
          "do": [
            {
              "rel": [
                "gordon_halvorsen",
                2
              ]
            },
            {
              "mood": 0.03
            }
          ],
          "to": "hub"
        },
        {
          "text": "Save them for Santa.",
          "to": "hub"
        }
      ]
    },
    "friend": {
      "say": [
        "THERE'S MY BUDDY! BIG GORD'S FAVOURITE RINK OWNER! COME HERE!",
        "{owner}! BIG GORD SAVED YOU A CANDY CANE! It's from last year. Still good."
      ],
      "options": [
        {
          "text": "Hey, Gord!",
          "to": "hub"
        }
      ]
    },
    "hub": {
      "say": [
        "WHAT CAN BIG GORD DO FOR YOU?",
        "{owner}! BIG GORD'S LISTENING! LOUDLY!",
        "HEY! YOU! THE OWNER! HOW ARE YA?"
