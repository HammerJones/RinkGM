    "rink": {
      "say": "GREAT RINK! NEEDS A BILLBOARD! NEEDS A BIGGER SNOW TANK! FOR SANTA! Big Gord rides in on Doris every December, you know!",
      "options": [
        {
          "text": "And the ice now? It's better!",
          "if": [
            {
              "ice_gte": 62
            }
          ],
          "to": "rink_ice"
