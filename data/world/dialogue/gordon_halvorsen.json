      "say": "YOUR RINK? ON A BIG GORD BILLBOARD? HIGHWAY 9! A HUNDRED BUCKS, HALF PRICE, FOR THE RINK! YOUR FACE NEXT TO MY FACE!",
      "options": [
        {
          "text": "Deal. A hundred bucks.",
          "do": [
            {
              "money": -100
            },
            {
              "rep": 2
            },
            {
              "set": "gord_billboard_rink"
            },
            {
              "set": "gord_billboard_decided"
            },
            {
              "rel": [
                "gordon_halvorsen",
                5
              ]
            },
            {
              "rel": [
                "june_penner",
                -3
              ]
            },
            {
              "note": "The rink is on a Big Gord billboard on Highway 9."
            }
          ],
          "to": "billboard_yes"
        },
        {
          "text": "No thanks, Gord. June would kill me.",
          "do": [
            {
              "set": "gord_billboard_decided"
            },
            {
              "rel": [
                "gordon_halvorsen",
                -1
              ]
            },
            {
              "rel": [
                "june_penner",
                2
              ]
            }
          ],
          "to": "hub"
        }
      ]
