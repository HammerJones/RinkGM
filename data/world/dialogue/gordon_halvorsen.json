          "text": "Save some ice time for the others, Gord.",
          "do": [
            {
              "rel": [
                "gordon_halvorsen",
                -1
              ]
            }
          ],
          "to": "hub"
        },
        {
          "text": "Go get 'em, Gord!",
          "do": [
            {
              "rel": [
                "gordon_halvorsen",
                2
              ]
            }
          ],
          "to": "end"
        }
      ]
