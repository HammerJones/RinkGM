    "billboard_yes": {
      "say": "BIG GORD AND THE RINK! IT'S GOING UP TUESDAY! I'M GOING TO POINT AT YOU IN IT!",
      "options": [
        {
          "text": "I'd expect nothing less.",
          "to": "hub"
        }
      ]
    },
    "june": {
      "say": "June thinks billboards ruin the view. I think billboards ARE the view! We've been at it since 1996. The Billboard War. She's a good woman. WRONG, BUT GOOD!",
      "options": [
        {
          "text": "Maybe tone it down near her store?",
          "do": [
            {
              "rel": [
                "gordon_halvorsen",
                -1
              ]
            },
            {
              "rel": [
                "june_penner",
                1
              ]
            }
          ],
          "to": "hub"
        },
        {
          "text": "Long may it rage.",
          "do": [
            {
              "rel": [
                "gordon_halvorsen",
                1
              ]
            }
          ],
          "to": "hub"
        }
      ]
