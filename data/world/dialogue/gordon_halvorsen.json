        {
          "text": "Doris's snow tank is all yours in December.",
          "do": [
            {
              "rel": [
                "gordon_halvorsen",
                2
              ]
            }
          ],
          "to": "hub"
        }
      ]
    },
    "rink_ice": {
      "say": "SMOOTH AS A NEW TRANSMISSION! BIG GORD APPROVES!",
      "options": [
        {
          "text": "High praise.",
          "to": "hub"
        }
      ]
    },
    "gm": {
      "say": "BIG GORD ALWAYS NEEDS GOOD PEOPLE! Detailers, lot kids, a guy to hold the balloon! Send your skaters to the lot! They'll want a bobblehead night, though. I want a bobblehead night.",
      "options": [
        {
          "text": "I'll think about the bobblehead.",
          "do": [
            {
              "rel": [
                "gordon_halvorsen",
                2
              ]
            }
          ],
          "to": "hub"
        }
      ]
    }
  }
