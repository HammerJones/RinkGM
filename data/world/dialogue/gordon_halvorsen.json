        {
          "text": "I'll fix it, Gord. Big Gord deserves better.",
          "do": [
            {
              "rel": [
                "gordon_halvorsen",
                2
              ]
            },
            {
              "mood": 0.05
            }
          ],
          "to": "hub"
        },
        {
          "text": "Have you tried shouting at it?",
          "do": [
            {
              "rel": [
                "gordon_halvorsen",
                1
              ]
            }
          ],
          "to": "hub"
        }
      ]
    },
    "bl_now": {
      "say": [
        "HAULERS TONIGHT! I PICKED THE LINES! I'M ON ALL OF THEM!",
        "POWER PLAY? BIG GORD'S THERE!"
