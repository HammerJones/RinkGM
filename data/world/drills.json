       {"start": [-0.86, 0.55], "queue": [-1, 0], "path": [[-0.4, 0.5, "fast"], [0.05, 0.45, "fast"], [0.4, 0.3, "catch"], [0.62, 0.12, "catch"], [0.72, 0.06, "shoot"], [0.8, 0.55, "stop"]]},
       {"start": [-0.05, 0.0], "queue": [0, 1], "path": [[0.25, 0.0, "back"], [0.5, 0.0, "back"], [0.66, -0.05, "back"], [0.72, 0.0, "stop"]]}
     ]},

