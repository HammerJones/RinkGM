  "negotiate": {
    "_doc": "What they say when they've swapped a shift to be here. {boss}, {kid}, {for}, {event}, {employer}, {job}.",
    "lines": [
      "Told {boss} it was {for}'s {event}. Owe somebody a Saturday now.",
      "Swapped with a guy from the afternoon crew. Cost me two coffees and my dignity.",
      "{boss} said no twice and yes the third time. I'm counting it.",
      "I'm technically at the dentist. Don't tell {employer}.",
      "Booked a half day in August for this. Worth it.",
      "Traded my Sunday for this. {for} doesn't know. Don't tell {for}.",
      "I asked {boss} if they'd ever seen a {event}. They hadn't. That's why I'm here and they're not.",
      "Left the line at {employer} running with the new kid. It'll be fine. It'll be fine."
    ],
    "refused": [
      "{boss} wouldn't let me off. I'll be listening on the radio in the break room.",
      "Couldn't get the shift swapped. Tell {for} I'm proud of them anyway."
    ]
  }
